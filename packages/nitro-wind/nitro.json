{
	"$schema": "https://nitro.margelo.com/nitro.schema.json",
	"cxxNamespace": ["nitrowind"],
	"ios": {
		"iosModuleName": "Nitrowind"
	},
	"android": {
		"androidNamespace": ["nitrowind"],
		"androidCxxLibName": "Nitrowind"
	},
	"autolinking": {
		"StyleEngine": {
			"all": {
				"language": "c++",
				"implementationClassName": "HybridStyleEngine"
			}
		},
		"NativeThemeTransition": {
			"ios": {
				"language": "swift",
				"implementationClassName": "HybridNativeThemeTransition"
			},
			"android": {
				"language": "c++",
				"implementationClassName": "HybridNativeThemeTransition"
			}
		}
	},
	"ignorePaths": ["**/node_modules"]
}
