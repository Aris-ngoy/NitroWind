{
	"name": "nitro-wind",
	"version": "0.1.0",
	"description": "High-performance Tailwind CSS engine for React Native, powered by Nitro Modules",
	"main": "./src/index.ts",
	"module": "./src/index.ts",
	"types": "./src/index.ts",
	"react-native": "./src/index.ts",
	"source": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./babel": "./babel.js",
		"./showcase": "./src/showcase.tsx"
	},
	"license": "MIT",
	"author": "Aristote Ngoy",
	"homepage": "https://github.com/Aris-ngoy/NitroWind#readme",
	"bugs": "https://github.com/Aris-ngoy/NitroWind/issues",
	"repository": {
		"type": "git",
		"url": "https://github.com/Aris-ngoy/NitroWind.git",
		"directory": "packages/nitro-wind"
	},
	"keywords": ["react-native", "tailwind", "nitro", "nitro-wind", "stylesheet", "nativewind"],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"clean": "git clean -dfX",
		"release": "semantic-release",
		"build": "bun run typecheck && bob build",
		"codegen": "nitrogen --logLevel=\"debug\" && bun run build && node post-script.js",
		"test": "bun test",
		"test:cpp": "clang++ -std=c++20 -I cpp cpp/tests/test_engine.cpp cpp/engine/Tokenizer.cpp cpp/engine/Parser.cpp cpp/engine/Theme.cpp cpp/engine/StyleCache.cpp cpp/engine/Engine.cpp -o /tmp/nitro_wind_engine_tests && /tmp/nitro_wind_engine_tests"
	},
	"files": [
		"src",
		"react-native.config.js",
		"lib",
		"nitrogen",
		"cpp",
		"nitro.json",
		"android/build.gradle",
		"android/fix-prefab.gradle",
		"android/gradle.properties",
		"android/CMakeLists.txt",
		"android/src",
		"ios/**/*.h",
		"ios/**/*.m",
		"ios/**/*.mm",
		"ios/**/*.cpp",
		"ios/**/*.swift",
		"app.plugin.js",
		"babel.js",
		"*.podspec",
		"README.md"
	],
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"dependencies": {
		"nitro-wind-core": "workspace:*"
	},
	"devDependencies": {
		"@types/react": "19.2.0",
		"nitrogen": "^0.36.1",
		"react": "19.2.3",
		"react-native": "0.86.0",
		"react-native-builder-bob": "^0.40.18",
		"react-native-nitro-modules": "^0.36.1",
		"semantic-release": "^25.0.7",
		"typescript": "^5.8.2"
	},
	"peerDependencies": {
		"react": "*",
		"react-native": "*",
		"react-native-nitro-modules": "*",
		"react-native-reanimated": "*"
	},
	"peerDependenciesMeta": {
		"react-native-reanimated": {
			"optional": true
		}
	},
	"react-native-builder-bob": {
		"source": "src",
		"output": "lib",
		"targets": [
			"commonjs",
			"module",
			[
				"typescript",
				{
					"project": "tsconfig.json"
				}
			]
		]
	}
}
