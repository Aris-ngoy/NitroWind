{
	"$schema": "https://mintlify.com/docs.json",
	"theme": "maple",
	"name": "nitro-wind",
	"description": "High-performance Tailwind CSS engine for React Native, powered by Nitro Modules.",
	"colors": {
		"primary": "#4F46E5",
		"light": "#818CF8",
		"dark": "#3730A3"
	},
	"logo": {
		"light": "/logo/light.svg",
		"dark": "/logo/dark.svg",
		"href": "https://github.com/Aris-ngoy/NitroWind"
	},
	"favicon": "/favicon.png",
	"icons": {
		"library": "lucide"
	},
	"appearance": {
		"default": "system"
	},
	"navbar": {
		"links": [
			{
				"type": "github",
				"href": "https://github.com/Aris-ngoy/NitroWind"
			}
		],
		"primary": {
			"type": "button",
			"label": "Get started",
			"href": "/guide/getting-started"
		}
	},
	"footer": {
		"socials": {
			"github": "https://github.com/Aris-ngoy/NitroWind",
			"x": "https://x.com/harrisngoy"
		},
		"links": [
			{
				"header": "Library",
				"items": [
					{
						"label": "GitHub",
						"href": "https://github.com/Aris-ngoy/NitroWind"
					},
					{
						"label": "npm",
						"href": "https://www.npmjs.com/package/nitro-wind"
					},
					{
						"label": "License",
						"href": "https://github.com/Aris-ngoy/NitroWind/blob/main/LICENSE"
					}
				]
			}
		]
	},
	"markdown": {
		"instructions": [
			"Write Tailwind utility className strings. Customize tokens with Tailwind v4 @theme in global.css and/or v3 tailwind.config.js (theme.extend). Do not add Metro CSS wrappers or Tailwind plugins. You do not import global.css in React Native.",
			"Add plugins: [\"nitro-wind/babel\"] and wrap the app in NitroWindProvider.",
			"className works on View, Text, Pressable, Image, ScrollView, TextInput, TouchableOpacity, and FlatList from react-native. Use styled() or withNitroWind() for every other host.",
			"Uniwind, withUniwind, and useUniwind are compatibility aliases. Prefer NitroWind, styled, and useNitroWind in new code.",
			"There are no pt-safe utilities. Use styled(SafeAreaView) or useSafeAreaInsets().",
			"Do not invent APIs. Fetch /llms.txt or /llms-full.txt. Install agent skills with: npx skills add Aris-ngoy/NitroWind"
		]
	},
	"contextual": {
		"options": ["copy", "view", "chatgpt", "claude", "cursor", "vscode"],
		"display": "header"
	},
	"search": {
		"prompt": "Search nitro-wind..."
	},
	"navigation": {
		"groups": [
			{
				"group": "Get started",
				"icon": "rocket",
				"pages": ["index", "guide/getting-started", "guide/ai"]
			},
			{
				"group": "Guide",
				"icon": "book-open",
				"pages": ["guide/styling", "guide/architecture", "guide/theming", "guide/tailwind-config", "guide/custom-themes", "guide/animations"]
			},
			{
				"group": "API",
				"icon": "code",
				"pages": ["api/overview"]
			},
			{
				"group": "Migration",
				"icon": "arrow-right-left",
				"pages": ["migration/nativewind", "migration/uniwind", "migration/unistyles"]
			}
		]
	},
	"redirects": [
		{
			"source": "/quickstart",
			"destination": "/guide/getting-started",
			"permanent": true
		},
		{
			"source": "/api",
			"destination": "/api/overview",
			"permanent": true
		},
		{
			"source": "/api/",
			"destination": "/api/overview",
			"permanent": true
		}
	]
}
