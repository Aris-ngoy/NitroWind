{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignore": [
			"**/dist/**",
			"**/lib/**",
			"**/node_modules/**",
			"**/.turbo/**",
			"**/build/**",
			"**/.expo/**",
			"**/docs/.mintlify/**",
			"**/nitrogen/**",
			"**/ios/Pods/**",
			"**/android/**",
			"**/ios/**",
			"**/vendor/**",
			"**/.claude/**",
			"**/*.podspec",
			"**/Gemfile.lock",
			"**/post-script.js"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"organizeImports": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"useNodejsImportProtocol": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always"
		}
	}
}
