{
	"name": "nitrowind-monorepo",
	"private": true,
	"workspaces": ["packages/*", "apps/*", "benchmarks", "docs"],
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"check": "biome check . && turbo run typecheck",
		"typecheck": "turbo run typecheck",
		"test": "bun test packages/nitro-wind-core packages/nitro-wind",
		"bench": "bun run --filter nitro-wind-benchmarks bench",
		"codegen": "bun run --filter nitro-wind codegen",
		"postinstall": "bash scripts/fix-expo-modules-jsi.sh"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"turbo": "^2.4.4",
		"typescript": "^5.8.2"
	},
	"packageManager": "bun@1.2.23",
	"version": "1.0.0",
	"dependencies": {
		"expo": "~57.0.21",
		"react": "19.2.3",
		"react-native": "0.86.3"
	}
}
